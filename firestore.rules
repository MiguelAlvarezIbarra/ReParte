rules_version = '2';

// Reglas de seguridad de ReParte (tarea T05).
// Regla general: solo un usuario autenticado puede leer y escribir.
// Ademas, cada quien solo modifica lo que le pertenece.
//
// Colecciones (ver lib/core/constantes/colecciones.dart):
//   usuarios/{uid}         nombre, correo, rol, telefono
//   donaciones/{id}        donanteId, descripcion, cantidadKg, caducidad,
//                          puntoEntregaId, creadaEn, estado, asociacionId
//   puntos_entrega/{id}    donanteId, nombre, direccion, latitud, longitud,
//                          horario
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esDueno(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    // Cada usuario crea y edita solo su propio perfil.
    match /usuarios/{uid} {
      allow read: if autenticado();
      allow create, update: if esDueno(uid);
      allow delete: if false;
    }

    // Ciclo de una donacion:
    //   disponible -> reservada  solo si sigue disponible y a nombre de quien
    //                            reserva (evita la doble reserva, T20)
    //   reservada  -> entregada  solo el donante o la asociacion que la reservo
    //   el donante puede editar o cancelar la suya mientras no este cerrada.
    // Una donacion entregada o cancelada queda cerrada: ya no cambia (T23).
    function cerrada() {
      return resource.data.estado in ['entregada', 'cancelada'];
    }

    function reservaValida() {
      return resource.data.estado == 'disponible'
        && resource.data.get('asociacionId', null) == null
        && request.resource.data.estado == 'reservada'
        && request.resource.data.asociacionId == request.auth.uid;
    }

    function entregaValida() {
      return resource.data.estado == 'reservada'
        && request.resource.data.estado == 'entregada'
        && request.resource.data.asociacionId == resource.data.asociacionId
        && (request.auth.uid == resource.data.donanteId
            || request.auth.uid == resource.data.asociacionId);
    }

    match /donaciones/{id} {
      allow read: if autenticado();
      allow create: if esDueno(request.resource.data.donanteId);
      allow update: if autenticado()
        && request.resource.data.donanteId == resource.data.donanteId
        && !cerrada()
        && (reservaValida() || entregaValida()
            || request.auth.uid == resource.data.donanteId);
      allow delete: if esDueno(resource.data.donanteId);
    }

    match /puntos_entrega/{id} {
      allow read: if autenticado();
      allow create: if esDueno(request.resource.data.donanteId);
      allow update, delete: if esDueno(resource.data.donanteId);
    }

    // Cualquier otra coleccion queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
